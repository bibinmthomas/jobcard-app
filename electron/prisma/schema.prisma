// Prisma schema for Job Card Generator

datasource db {
  provider = "sqlite"
  url      = "file:../database/jobcards.db"
}

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

// ─── Auth ──────────────────────────────────────────────────────────────────

model User {
  id        Int       @id @default(autoincrement())
  username  String    @unique
  password  String    // bcrypt hash
  role      String    @default("user") // "admin" | "user"
  isDeleted Boolean   @default(false)
  jobCards  JobCard[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ─── Accounts ──────────────────────────────────────────────────────────────

model Account {
  id            Int       @id @default(autoincrement())
  acctName      String
  address       String?
  city          String?
  pin           String?   // stored as string to preserve leading zeros
  fax           String?
  telex         String?
  contactPerson String?
  isDeleted     Boolean   @default(false)
  jobCards      JobCard[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([acctName, city])
}

// ─── Job Cards ─────────────────────────────────────────────────────────────

model JobCard {
  id           Int      @id @default(autoincrement())
  jobNo        String   // auto-generated: PREFIX/NNNN
  date         DateTime @default(now())

  // Core identification
  customer     String?
  contNo       String?  // Contract No
  lcCNo        String?  // L.C.C No
  ogcNo        String?  // O.G.C No
  partName     String?
  poNo         String?  // P.O. No
  billNo       String?
  dwgNo        String?  // Drawing No
  qty          Int?

  // Setting section
  settingStartTime String?
  settingEndTime   String?
  settingTotalTime String?

  // Job section
  jobStartTime String?
  jobEndTime   String?
  jobTotalTime String?

  // Machine Hours section
  mcHrsStart   String?
  mcHrsEnd     String?
  mcTotalTime  String?

  // Specifications
  pl           String?
  thickness    String?
  taper        String?

  // Assignment
  operator     String?
  remark       String?
  progNo       String?
  amount       String   @default("0.00")

  // Extra fields from settings (JSON object: { fieldName: value })
  extraFields  String?

  // Relations
  accountId    Int
  account      Account  @relation(fields: [accountId], references: [id])
  userId       Int
  user         User     @relation(fields: [userId], references: [id])

  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── Form Fields (settings-defined extra fields) ───────────────────────────

model FormField {
  id        Int      @id @default(autoincrement())
  name      String   @unique // used as key in JobCard.extraFields JSON
  label     String           // display label
  type      String           // "string" | "number" | "date" | "multiselect"
  options   String?          // JSON array of strings (for multiselect)
  required  Boolean  @default(false)
  order     Int      @default(0)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── App Settings ──────────────────────────────────────────────────────────

model AppSettings {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String   // JSON string
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
